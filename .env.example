# DeviceFlow environment template.
# Copy to `.env` (which is git-ignored) and adjust. Every value below is a
# DEVELOPMENT-ONLY placeholder. Never reuse these values in a real deployment.

# --- PostgreSQL (used by docker-compose.yml) ---------------------------------
POSTGRES_USER=deviceflow
POSTGRES_PASSWORD=deviceflow_dev_only
POSTGRES_DB=deviceflow

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Local development connects to the Compose database on localhost:5432.
DATABASE_URL=postgresql://deviceflow:deviceflow_dev_only@localhost:5432/deviceflow
# Integration tests use a separate database (created by docker/postgres-init).
TEST_DATABASE_URL=postgresql://deviceflow:deviceflow_dev_only@localhost:5432/deviceflow_test

# Origins allowed to send state-changing requests (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to true whenever the app is served over HTTPS (required in production).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (nginx in Docker = 1).
TRUST_PROXY=0
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_RATE_LIMIT_MAX=10

# --- Development seed --------------------------------------------------------
# Password given to every seeded demo user. Development and demos only.
# Replace the placeholder with your own value (at least 12 characters).
SEED_DEFAULT_PASSWORD=change-me-to-12-plus-chars
